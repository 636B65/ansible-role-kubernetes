        <mxCell id="admin" value="&lt;b&gt;Ansible controller&lt;/b&gt;&lt;br&gt;Ansible 2.16+ · SSH + become&lt;br&gt;site.yml: install and configure&lt;br&gt;upgrade.yml: rolling upgrades&lt;br&gt;remove-node.yml: scale in" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0052CC;strokeWidth=2;fillColor=#DEEBFF;fontSize=15;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="42" y="290" width="265" height="150" as="geometry"/></mxCell>
        <mxCell id="upstream" value="&lt;b&gt;Upstream sources&lt;/b&gt;&lt;br&gt;docker.io · quay.io&lt;br&gt;registry.k8s.io · ghcr.io&lt;br&gt;pkgs.k8s.io · Helm repos&lt;br&gt;All versions and tags pinned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#6554C0;strokeWidth=2;fillColor=#EAE6FF;fontSize=15;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="42" y="725" width="265" height="165" as="geometry"/></mxCell>
        <mxCell id="bundle" value="&lt;b&gt;Offline bundle&lt;/b&gt;&lt;br&gt;/opt/kubernetes-offline&lt;br&gt;.deb repository · image archives&lt;br&gt;charts · manifests · CLIs&lt;br&gt;Staged with offline_stage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#97A0AF;strokeWidth=2;fillColor=#FFFFFF;fontSize=15;fontColor=#172B4D;spacing=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="42" y="500" width="265" height="165" as="geometry"/></mxCell>
        <mxCell id="vip" value="&lt;b&gt;Kubernetes API virtual endpoint&lt;/b&gt;&lt;br&gt;Keepalived-managed VIP · active on one controller&lt;br&gt;HAProxy TCP :8443 · round-robin to :6443 with TCP health checks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#FF8B00;strokeWidth=2;fillColor=#FFF0B3;fontSize=15;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="112" width="640" height="78" as="geometry"/></mxCell>
        <mxCell id="cluster" value="KUBERNETES CLUSTER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;dashPattern=8 4;strokeColor=#7A869A;strokeWidth=2;fillColor=#F7F9FC;align=left;verticalAlign=top;spacingTop=14;spacingLeft=20;fontSize=15;fontStyle=1;fontColor=#344563;" vertex="1" parent="1"><mxGeometry x="355" y="205" width="1140" height="860" as="geometry"/></mxCell>
        <mxCell id="backend_pool" value="&lt;b&gt;HAProxy backend pool&lt;/b&gt; · kube-cp01 :6443 · kube-cp02 :6443 · kube-cp03 :6443" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#FFAB00;strokeWidth=2;fillColor=#FFFAE6;fontSize=14;fontColor=#5E4DB2;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="240" width="1030" height="44" as="geometry"/></mxCell>
        <mxCell id="cp01" value="&lt;b&gt;kube-cp01&lt;/b&gt;&lt;br&gt;Control plane + etcd&lt;br&gt;kube-apiserver :6443&lt;br&gt;audit log · Secret encryption&lt;br&gt;Pod Security (baseline)&lt;br&gt;HAProxy + Keepalived&lt;br&gt;etcd backup timer&lt;br&gt;Registry + Buildah build node" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0747A6;strokeWidth=2;fillColor=#DEEBFF;fontSize=14;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="395" y="320" width="310" height="185" as="geometry"/></mxCell>
        <mxCell id="cp02" value="&lt;b&gt;kube-cp02&lt;/b&gt;&lt;br&gt;Control plane + etcd&lt;br&gt;kube-apiserver :6443&lt;br&gt;audit log · Secret encryption&lt;br&gt;Pod Security (baseline)&lt;br&gt;HAProxy + Keepalived&lt;br&gt;etcd backup timer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0747A6;strokeWidth=2;fillColor=#DEEBFF;fontSize=14;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="770" y="320" width="310" height="185" as="geometry"/></mxCell>
        <mxCell id="cp03" value="&lt;b&gt;kube-cp03&lt;/b&gt;&lt;br&gt;Control plane + etcd&lt;br&gt;kube-apiserver :6443&lt;br&gt;audit log · Secret encryption&lt;br&gt;Pod Security (baseline)&lt;br&gt;HAProxy + Keepalived&lt;br&gt;etcd backup timer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0747A6;strokeWidth=2;fillColor=#DEEBFF;fontSize=14;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="1145" y="320" width="310" height="185" as="geometry"/></mxCell>
        <mxCell id="controller_note" value="HAProxy runs on all controllers with an identical backend pool. Keepalived moves the API VIP between controllers on failover.&lt;br&gt;Every node can run the optional nftables host firewall; apt holds kubelet, kubeadm, and kubectl at the pinned release." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#FFAB00;strokeWidth=2;fillColor=#FFFAE6;fontSize=13;fontColor=#5E4DB2;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="525" width="1030" height="48" as="geometry"/></mxCell>
        <mxCell id="cilium" value="&lt;b&gt;Cilium CNI overlay&lt;/b&gt; · pod networking across all nodes · Hubble Relay + UI for flow visibility" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#00875A;strokeWidth=2;fillColor=#E3FCEF;fontSize=15;fontColor=#006644;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="593" width="1030" height="50" as="geometry"/></mxCell>
        <mxCell id="worker01" value="&lt;b&gt;kube-wl01&lt;/b&gt;&lt;br&gt;Worker node&lt;br&gt;kubelet + containerd&lt;br&gt;Longhorn replica" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#00875A;strokeWidth=2;fillColor=#E3FCEF;fontSize=15;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="670" width="190" height="125" as="geometry"/></mxCell>
        <mxCell id="worker02" value="&lt;b&gt;kube-wl02&lt;/b&gt;&lt;br&gt;Worker node&lt;br&gt;kubelet + containerd&lt;br&gt;Longhorn replica" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#00875A;strokeWidth=2;fillColor=#E3FCEF;fontSize=15;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="670" width="190" height="125" as="geometry"/></mxCell>
        <mxCell id="worker03" value="&lt;b&gt;kube-wl03&lt;/b&gt;&lt;br&gt;Worker node&lt;br&gt;kubelet + containerd&lt;br&gt;Longhorn replica" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#00875A;strokeWidth=2;fillColor=#E3FCEF;fontSize=15;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="830" y="670" width="190" height="125" as="geometry"/></mxCell>
        <mxCell id="registry" value="&lt;b&gt;Internal registry · 2 pods&lt;/b&gt;&lt;br&gt;NodePort :30500 · registry.k8s.local&lt;br&gt;Anonymous pull · plain HTTP · trusted network only&lt;br&gt;Longhorn RWX volume · 3 replicas on workers&lt;br&gt;Mirrored: pinned images · Cilium images&lt;br&gt;Built: ubuntu-base · nginx-static skeletons" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#6554C0;strokeWidth=2;fillColor=#EAE6FF;fontSize=14;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="1045" y="663" width="400" height="190" as="geometry"/></mxCell>
        <mxCell id="addons" value="&lt;b&gt;Cluster add-ons&lt;/b&gt;&lt;br&gt;metrics-server · Hubble Relay + UI&lt;br&gt;Headlamp web UI (ClusterIP, token sign-in)&lt;br&gt;kube-prometheus-stack (optional)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#008DA6;strokeWidth=2;fillColor=#E6FCFF;fontSize=14;fontColor=#172B4D;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="820" width="610" height="105" as="geometry"/></mxCell>
        <mxCell id="stats" value="&lt;b&gt;HAProxy statistics&lt;/b&gt;&lt;br&gt;HTTP :8404/stats on each controller · unauthenticated" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#6554C0;strokeWidth=2;fillColor=#F4F0FF;fontSize=13;fontColor=#403294;spacing=10;" vertex="1" parent="1"><mxGeometry x="1045" y="880" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Traffic and placement&lt;/b&gt;&lt;br&gt;Solid arrows: API and image flows · dashed arrow: offline bundle copy&lt;br&gt;Dashed green lines: Cilium pod network&lt;br&gt;Keepalived advertises among controllers (VRRP unicast)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#97A0AF;strokeWidth=2;fillColor=#FFFFFF;fontSize=13;fontColor=#344563;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="950" width="610" height="90" as="geometry"/></mxCell>
