<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="24.7.17">
  <diagram id="kubernetes-ha-architecture" name="Kubernetes HA Architecture">
    <mxGraphModel dx="1540" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Kubernetes HA Cluster — Ansible Role Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="42" y="26" width="1040" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="containerd · kubeadm · Cilium · HAProxy · Keepalived · Longhorn replicated registry storage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#526581;" vertex="1" parent="1">
          <mxGeometry x="44" y="72" width="1050" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="cluster" value="KUBERNETES CLUSTER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;dashed=1;dashPattern=8 4;strokeColor=#7A869A;strokeWidth=2;fillColor=#F7F9FC;verticalAlign=top;spacingTop=14;fontSize=15;fontStyle=1;fontColor=#344563;" vertex="1" parent="1">
          <mxGeometry x="355" y="205" width="1140" height="735" as="geometry"/>
        </mxCell>

        <mxCell id="admin" value="&lt;b&gt;Ansible controller&lt;/b&gt;&lt;br&gt;Ansible 2.16+&lt;br&gt;SSH + become&lt;br&gt;Installs and configures all nodes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeColor=#0052CC;strokeWidth=2;fillColor=#DEEBFF;fontSize=15;fontColor=#172B4D;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="42" y="295" width="265" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="clients" value="&lt;b&gt;Kubernetes clients&lt;/b&gt;&lt;br&gt;kubectl · kubelets · operators&lt;br&gt;Connect to the stable API endpoint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeColor=#008DA6;strokeWidth=2;fillColor=#E6FCFF;fontSize=15;fontColor=#172B4D;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="42" y="120" width="265" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="dockerhub" value="&lt;b&gt;External image sources&lt;/b&gt;&lt;br&gt;Docker Hub&lt;br&gt;ubuntu:latest&lt;br&gt;ubuntu/nginx:latest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeColor=#6554C0;strokeWidth=2;fillColor=#EAE6FF;fontSize=15;fontColor=#172B4D;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="42" y="690" width="265" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="vip" value="&lt;b&gt;Kubernetes API virtual endpoint&lt;/b&gt;&lt;br&gt;Keepalived-managed VIP · active on one controller&lt;br&gt;HAProxy TCP :8443 · backend round-robin to :6443&lt;br&gt;TCP health checks across all three API servers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeColor=#FF8B00;strokeWidth=2;fillColor=#FFF0B3;fontSize=15;fontColor=#172B4D;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="112" width="640" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="backend_pool" value="&lt;b&gt;HAProxy backend pool&lt;/b&gt; · kube-cp01 :6443 · kube-cp02 :6443 · kube-cp03 :6443" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#FFAB00;strokeWidth=1;fillColor=#FFFAE6;fontSize=14;fontColor=#5E4DB2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="230" width="1030" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="cp01" value="&lt;b&gt;kube-cp01&lt;/b&gt;&lt;br&gt;Control plane + etcd&lt;br&gt;kube-apiserver :6443&lt;br&gt;HAProxy + Keepalived&lt;br&gt;Registry storage host" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#0747A6;strokeWidth=2;fillColor=#DEEBFF;fontSize=15;fontColor=#172B4D;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="395" y="315" width="310" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="cp02" value="&lt;b&gt;kube-cp02&lt;/b&gt;&lt;br&gt;Control plane + etcd&lt;br&gt;kube-apiserver :6443&lt;br&gt;HAProxy + Keepalived" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#0747A6;strokeWidth=2;fillColor=#DEEBFF;fontSize=15;fontColor=#172B4D;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="315" width="310" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="cp03" value="&lt;b&gt;kube-cp03&lt;/b&gt;&lt;br&gt;Control plane + etcd&lt;br&gt;kube-apiserver :6443&lt;br&gt;HAProxy + Keepalived" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#0747A6;strokeWidth=2;fillColor=#DEEBFF;fontSize=15;fontColor=#172B4D;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1145" y="315" width="310" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="controller_note" value="HAProxy runs on all controllers with an identical backend pool. Keepalived moves the API VIP between controllers on failover; stats on the VIP show only its active controller." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#FFAB00;strokeWidth=1;fillColor=#FFFAE6;fontSize=13;fontColor=#5E4DB2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="470" width="1030" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="cilium" value="&lt;b&gt;Cilium CNI overlay&lt;/b&gt; · Pod networking across control-plane and worker nodes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#00875A;strokeWidth=2;fillColor=#E3FCEF;fontSize=15;fontColor=#006644;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="545" width="1030" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="worker01" value="&lt;b&gt;kube-wl01&lt;/b&gt;&lt;br&gt;Worker node&lt;br&gt;kubelet + containerd" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#00875A;strokeWidth=2;fillColor=#E3FCEF;fontSize=15;fontColor=#172B4D;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="630" width="190" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="worker02" value="&lt;b&gt;kube-wl02&lt;/b&gt;&lt;br&gt;Worker node&lt;br&gt;kubelet + containerd" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#00875A;strokeWidth=2;fillColor=#E3FCEF;fontSize=15;fontColor=#172B4D;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="630" width="190" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="worker03" value="&lt;b&gt;kube-ws03&lt;/b&gt;&lt;br&gt;Worker node&lt;br&gt;kubelet + containerd" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#00875A;strokeWidth=2;fillColor=#E3FCEF;fontSize=15;fontColor=#172B4D;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="630" width="190" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="registry" value="&lt;b&gt;Internal Docker Distribution registry · 2 pods&lt;/b&gt;&lt;br&gt;NodePort :30500 · registry.k8s.local&lt;br&gt;Shared Longhorn RWX volume · 3 replicas on separate nodes&lt;br&gt;Survives one controller failure with healthy storage replicas&lt;br&gt;Plain HTTP; restrict to trusted network&lt;br&gt;Ubuntu + Ubuntu/nginx images imported by Skopeo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#6554C0;strokeWidth=2;fillColor=#EAE6FF;fontSize=14;fontColor=#172B4D;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1045" y="620" width="400" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="stats" value="&lt;b&gt;HAProxy statistics&lt;/b&gt;&lt;br&gt;HTTP :8404/stats on each controller&lt;br&gt;Unauthenticated · restrict network access" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#6554C0;strokeWidth=1;fillColor=#F4F0FF;fontSize=13;fontColor=#403294;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="410" y="790" width="360" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Traffic and placement&lt;/b&gt;&lt;br&gt;Solid arrows: API and image flows&lt;br&gt;Dashed green line: Cilium pod network&lt;br&gt;Keepalived advertises among controllers (VRRP/unicast)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#97A0AF;fillColor=#FFFFFF;fontSize=13;fontColor=#344563;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="790" width="645" height="95" as="geometry"/>
        </mxCell>

