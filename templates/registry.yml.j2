apiVersion: apps/v1
kind: Deployment
metadata:
  name: kubernetes-image-registry
  namespace: {{ kubernetes_registry_namespace }}
spec:
  replicas: {{ kubernetes_registry_replicas }}
  selector:
    matchLabels:
      app: kubernetes-image-registry
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  template:
    metadata:
      labels:
        app: kubernetes-image-registry
    spec:
      securityContext:
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: kubernetes.io/hostname
              labelSelector:
                matchLabels:
                  app: kubernetes-image-registry
      containers:
        - name: registry
          image: {{ kubernetes_registry_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: REGISTRY_HTTP_SECRET
              valueFrom:
                secretKeyRef:
                  name: kubernetes-image-registry-http
                  key: http-secret
          ports:
            - name: registry
              containerPort: 5000
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /v2/
              port: registry
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /v2/
              port: registry
            initialDelaySeconds: 10
            periodSeconds: 10
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
          volumeMounts:
            - name: registry-data
              mountPath: /var/lib/registry
      volumes:
        - name: registry-data
          persistentVolumeClaim:
            claimName: registry-data
---
apiVersion: v1
kind: Service
metadata:
  name: kubernetes-image-registry
  namespace: {{ kubernetes_registry_namespace }}
spec:
  type: NodePort
  selector:
    app: kubernetes-image-registry
  ports:
    - name: registry
      port: 5000
      targetPort: registry
      nodePort: {{ kubernetes_registry_node_port }}
      protocol: TCP
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: kubernetes-image-registry
  namespace: {{ kubernetes_registry_namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: kubernetes-image-registry
