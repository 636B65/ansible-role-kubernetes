apiVersion: v1
kind: Namespace
metadata:
  name: {{ kubernetes_registry_namespace }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kubernetes-image-registry
  namespace: {{ kubernetes_registry_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: kubernetes-image-registry
  template:
    metadata:
      labels:
        app: kubernetes-image-registry
    spec:
      nodeSelector:
        kubernetes.io/hostname: {{ kubernetes_registry_node }}
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      containers:
        - name: registry
          image: {{ kubernetes_registry_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: registry
              containerPort: 5000
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /v2/
              port: registry
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /v2/
              port: registry
            initialDelaySeconds: 10
            periodSeconds: 10
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
          volumeMounts:
            - name: registry-data
              mountPath: /var/lib/registry
      volumes:
        - name: registry-data
          hostPath:
            path: {{ kubernetes_registry_storage_path }}
            type: Directory
---
apiVersion: v1
kind: Service
metadata:
  name: kubernetes-image-registry
  namespace: {{ kubernetes_registry_namespace }}
spec:
  type: NodePort
  selector:
    app: kubernetes-image-registry
  ports:
    - name: registry
      port: 5000
      targetPort: registry
      nodePort: {{ kubernetes_registry_node_port }}
      protocol: TCP
