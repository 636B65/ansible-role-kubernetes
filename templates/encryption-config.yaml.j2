# {{ ansible_managed }}
apiVersion: apiserver.config.k8s.io/v1
kind: EncryptionConfiguration
resources:
  - resources:
      - secrets
    providers:
{% if kubernetes_secrets_encryption_stage == 'active' %}
      - secretbox:
          keys:
            - name: key1
              secret: {{ kubernetes_secrets_encryption_key_value }}
      - identity: {}
{% else %}
      - identity: {}
      - secretbox:
          keys:
            - name: key1
              secret: {{ kubernetes_secrets_encryption_key_value }}
{% endif %}
