apiVersion: v1
kind: Namespace
metadata:
  name: {{ kubernetes_registry_namespace }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: registry-data
  namespace: {{ kubernetes_registry_namespace }}
spec:
  accessModes:
    - ReadWriteMany
  storageClassName: {{ kubernetes_registry_storage_class }}
  resources:
    requests:
      storage: {{ kubernetes_registry_storage_size }}
