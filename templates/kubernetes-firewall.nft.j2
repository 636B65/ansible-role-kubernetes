#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Host input filter for Kubernetes nodes. It lives in its own table so it never
# flushes the rules that kube-proxy and Cilium manage. Declaring and deleting
# the table first makes every reload replace it atomically.
table inet kubernetes_host_firewall
delete table inet kubernetes_host_firewall

table inet kubernetes_host_firewall {
    set cluster_nodes {
        type ipv4_addr
        elements = { {{ kubernetes_cluster_hosts | map('extract', hostvars, 'ansible_host') | unique | join(', ') }} }
    }
{% for set_name, networks in [('admin_networks', kubernetes_firewall_admin_networks), ('api_networks', kubernetes_firewall_api_networks), ('nodeport_networks', kubernetes_firewall_nodeport_networks)] if networks | length > 0 %}

    set {{ set_name }} {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { {{ networks | join(', ') }} }
    }
{% endfor %}

    chain input {
        type filter hook input priority filter + 10; policy drop;

        ct state established,related accept
        ct state invalid drop
        iifname "lo" accept

        meta l4proto icmp accept
        meta l4proto ipv6-icmp accept
        udp dport 68 accept
        udp dport 546 accept

        # Node-to-node traffic: Kubernetes, etcd, Cilium, Longhorn, and VRRP.
        ip saddr @cluster_nodes accept

        # Pod and Cilium host traffic, for example kubelet probes and metrics.
        ip saddr {{ kubernetes_pod_network_cidr }} accept
        iifname "cilium_*" accept
        iifname "lxc*" accept
{% if kubernetes_firewall_admin_networks | length > 0 %}

        ip saddr @admin_networks tcp dport {{ kubernetes_firewall_ssh_port }} accept
{% if inventory_hostname in groups[kubernetes_control_plane_group] %}
        ip saddr @admin_networks tcp dport {{ haproxy_stats_port }} accept
{% endif %}
{% endif %}
{% if inventory_hostname in groups[kubernetes_control_plane_group] and kubernetes_firewall_api_networks | length > 0 %}

        ip saddr @api_networks ip daddr {{ kubernetes_api_vip }} tcp dport {{ kubernetes_api_port }} accept
        ip saddr @api_networks tcp dport {{ kubernetes_apiserver_port }} accept
{% endif %}
{% if kubernetes_firewall_nodeport_networks | length > 0 %}

        ip saddr @nodeport_networks tcp dport 30000-32767 accept
        ip saddr @nodeport_networks udp dport 30000-32767 accept
{% endif %}
{% for rule in kubernetes_firewall_extra_input_rules %}
{% if loop.first %}

{% endif %}
        {{ rule }}
{% endfor %}
    }
}
